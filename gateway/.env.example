# Bun loads this file automatically
PORT=3000
REDIS_URL=

# Random secret you choose; Telegram passes it back in the URL path
WEBHOOK_TOKEN=

# Needed only by scripts/setWebhook.ts
BOT_TOKEN=
PUBLIC_URL=https://your-domain.com

# Bot username without @ (to ignore /fight@OtherBot in groups)
BOT_USERNAME=

# Approximate stream caps (XADD MAXLEN ~)
MAXLEN_PRIVATE=300000
MAXLEN_GROUPS=100000

# 1 = several processes on the same port (Linux/WSL2 only)
REUSE_PORT=0

# Error logging (errors only, written to files)
LOG_DIR=./logs
LOG_MAX_SIZE=2m
LOG_RETENTION_DAYS=7
# identical errors are written at most once per this many ms (suppressed count is logged)
LOG_THROTTLE_MS=1000

# Reuse SERVER_NAME across services on this physical server; use another name on each server.
SERVER_NAME=server-01
INSTANCE_NAME=
SERVER_METRICS_INTERVAL_MS=5000
# Optional shared monitoring namespace. Leave empty to derive it from BOT_TOKEN.
MONITORING_NAMESPACE=rps-worker-main