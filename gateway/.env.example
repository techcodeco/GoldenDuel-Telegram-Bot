# Bun loads .env automatically
# Nginx listens publicly on 80/443 and forwards requests to this local port.
HOST=127.0.0.1
PORT=3000
REDIS_URL=redis://127.0.0.1:6379

# Telegram Bot API credential. Keep it only in this private .env file.
# It is needed by setWebhook.ts and poll.ts; Telegram's Bot API itself requires
# this token in the outgoing API endpoint path.
BOT_TOKEN=

# Incoming webhook authentication secret. Telegram sends it in the
# X-Telegram-Bot-Api-Secret-Token request header.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# Public HTTPS origin only; do not append a port or /webhook.
PUBLIC_URL=https://dezhbanbot.ir

# Bot username without @ (to ignore /fight@OtherBot in groups)
BOT_USERNAME=

# Approximate stream caps (XADD MAXLEN ~)
MAXLEN_PRIVATE=300000
MAXLEN_GROUPS=100000

# 1 = several processes on the same port (Linux/WSL2 only)
REUSE_PORT=0

# Error logging (errors only, written to files)
LOG_DIR=./logs
LOG_MAX_SIZE=2m
LOG_RETENTION_DAYS=7
# identical errors are written at most once per this many ms (suppressed count is logged)
LOG_THROTTLE_MS=1000

# Reuse SERVER_NAME across services on this physical server; use another name on each server.
SERVER_NAME=server-01
INSTANCE_NAME=
SERVER_METRICS_INTERVAL_MS=5000
# Optional shared monitoring namespace. Leave empty to derive it from BOT_TOKEN.
MONITORING_NAMESPACE=gd-worker-main
