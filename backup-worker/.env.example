# MongoDB Database Tools must be installed (mongodump is used by backup-worker).
# Use the exact database URI you want to back up. Database path limits the dump to that DB.
MONGO_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/rps?authSource=admin

# REQUIRED: encrypt the final backup before sending it to Telegram (AES-256-GCM).
# Generate a strong value with: openssl rand -base64 32
# Keep a secure copy. Losing/changing it without retaining the old value makes existing backups unrecoverable.
BACKUP_ENCRYPTION_PASSWORD=

# Same Telegram bot token as private-worker and the owner's numeric Telegram ID(s).
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
OWNER_IDS=123456789
# Optional: use a locally hosted Telegram Bot API server if configured; cloud API default below.
TELEGRAM_API_ROOT=https://api.telegram.org
# Cloud Bot API upload is limited to 50 MB; configurable safe ceiling is 49 MB.
TELEGRAM_UPLOAD_MAX_MB=47

# These must match private-worker / other workers exactly.
REDIS_URL=redis://127.0.0.1:6379
MONITORING_NAMESPACE=gd-worker-main
SERVER_NAME=server-01
INSTANCE_NAME=backup-worker-01
SERVER_METRICS_INTERVAL_MS=5000

# Initial value; owner can change this live from the Telegram admin panel (1..1440 minutes).
BACKUP_INTERVAL_MINUTES=15
BACKUP_HISTORY_LIMIT=500
BACKUP_LOCK_TTL_SECONDS=3600
# Full deployment + replica-set only. Leave false for a single named database.
BACKUP_OPLOG=false
# Optional: defaults to OS temporary directory.
# BACKUP_TMP_DIR=/tmp
MONGODUMP_BIN=mongodump

LOG_LEVEL=info
LOG_DIR=./logs/backup-worker
LOG_MAX_SIZE=5m
LOG_RETENTION_DAYS=14
LOG_THROTTLE_MS=1000
