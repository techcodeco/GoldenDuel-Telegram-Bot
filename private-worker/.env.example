# Copy to .env and fill in real values. Keep SERVER_NAME identical on every service on this physical server.
SERVER_NAME=server-01
INSTANCE_NAME=
SERVER_METRICS_INTERVAL_MS=5000
# Leave blank to derive the monitoring namespace from BOT_TOKEN. If using an override, use the same value in every service.
MONITORING_NAMESPACE=gd-worker-main

BOT_TOKEN=
OWNER_IDS=
REDIS_URL=
MONGO_URI=
PRIVATE_UPDATES_STREAM=updates:private
GROUP_UPDATES_STREAM=updates:groups
TIMING_COMMAND_STREAM=gd:timing:commands
BROADCAST_COMMAND_STREAM=gd:broadcast:commands
BATCH=100
CONCURRENCY=50
BLOCK_MS=2000
LOG_DIR=./logs
LOG_MAX_SIZE=2m
LOG_RETENTION_DAYS=7
LOG_THROTTLE_MS=1000
TON_NETWORK=mainnet
TONCENTER_API_URL=https://toncenter.com/api/v3
TONCENTER_API_KEY_TESTNET=
TONCENTER_API_KEY_MAINNET=
TONCENTER_API_KEY=
