# Same shared infrastructure and bot token as private-worker / bullMQ-worker
BOT_TOKEN=
BOT_USERNAME=
REDIS_URL=
MONGO_URI=
GROUP_UPDATES_STREAM=updates:groups
GROUP_CONSUMER_GROUP=group-workers
TIMING_COMMAND_STREAM=gd:timing:commands
BATCH=50
BLOCK_MS=2000

SERVER_NAME=server-01
INSTANCE_NAME=
SERVER_METRICS_INTERVAL_MS=5000
MONITORING_NAMESPACE=gd-worker-main

# Structured Pino logs (rotating daily, size-limited; errors only by default)
LOG_DIR=./logs
LOG_LEVEL=error
LOG_MAX_SIZE=2m
LOG_RETENTION_DAYS=7
LOG_THROTTLE_MS=1000
